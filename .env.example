# UNLAWYERED server environment (all optional)
# Keys are normally entered on the Settings page and stored encrypted at rest.
# You can instead pre-seed a default key for a provider via env (never committed).

# PORT=8787
# UNLAWYERED_SECRET=change-me-to-a-long-random-string   # key-store encryption secret
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
